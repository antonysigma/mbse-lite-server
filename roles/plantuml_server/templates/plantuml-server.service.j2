[Unit]
Description=PlantUML PicoWeb Server
Documentation=https://plantuml.com/picoweb
After=network.target

[Service]
Type=simple
User={{ plantuml_server_user }}
Group={{ plantuml_server_user }}
WorkingDirectory={{ plantuml_server_home }}
ExecStart=/usr/bin/java -jar {{ plantuml_server_jar_path }} -picoweb:{{ plantuml_server_port }}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ plantuml_server_home }}

[Install]
WantedBy=multi-user.target
